APP_NAME="Flower Shop API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Yekaterinburg

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=flower_shop
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="shop@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Адрес клиентского приложения (Vue). Несколько адресов — через запятую.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Время жизни токена Sanctum в минутах (7 дней)
SANCTUM_EXPIRATION=10080

# ИИ-сервис (OpenAI-совместимый API: Ollama, YandexGPT, OpenAI, DeepSeek и т. п.)
# При AI_ENABLED=false или недоступности сервиса используется встроенный алгоритм.
AI_ENABLED=false
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=
AI_MODEL=qwen2.5:7b
AI_TIMEOUT=20
